{
    "name": "dgtlss/atlas",
    "description": "Expose selected Laravel routes as agent-readable Markdown and JSON without changing their HTML behavior.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Nathan Langer",
            "email": "nathanlanger@googlemail.com"
        }
    ],
    "keywords": [
        "laravel",
        "ai",
        "agent",
        "ai-seo",
        "markdown",
        "json",
        "routes",
        "atlas"
    ],
    "require": {
        "php": "^8.1",
        "illuminate/cache": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "league/html-to-markdown": "^5.1"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Dgtlss\\Atlas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dgtlss\\Atlas\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dgtlss\\Atlas\\AtlasServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
